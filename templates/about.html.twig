{% extends "layout.html.twig" %}

{% block title %}About - Sage Sucre{% endblock %}

{% block content %}
<section class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold mb-6 text-[#2c2b28]">About Sage Sucre</h1>

    <div class="bg-[#fffaf5] border border-[#e9e2d8] rounded-2xl p-8 shadow-sm">
        <p class="text-lg text-[#6b6a66] mb-4">
            Sage Sucre is a small homemade sweets business run by Sabrina Moustaine.
            The business focuses on custom desserts, cakes, cupcakes, and sweet treats
            made for special events and personal orders.
        </p>

        <p class="text-lg text-[#6b6a66] mb-4">
            Before this website, orders were mainly handled through Instagram messages.
            This website helps make the ordering process easier by letting customers
            browse products, submit orders, and choose pickup details in one place.
        </p>

        <p class="text-lg text-[#6b6a66]">
            Our goal is to give Sage Sucre a simple and organized online system that
            supports both customers and the business owner.
        </p>
    </div>
</section>
{% endblock %}