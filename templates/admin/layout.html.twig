<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#e07a5f',
            secondary: '#fdf3e7',
            background: '#fffaf5',
            foreground: '#2c2b28',
            border: '#e9e2d8',
          }
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>body { background: #f8f4ef; }</style>
</head>
<body class="font-sans antialiased">

<div class="flex min-h-screen">

  <!-- Sidebar -->
  <aside class="w-64 bg-white border-r border-border flex flex-col fixed h-full z-40">
    <div class="px-6 py-5 border-b border-border">
      <a href="/" class="flex items-center gap-2">
        <span class="text-2xl">🌸</span>
        <div>
          <p class="font-bold text-foreground">Sage Sucre</p>
          <p class="text-xs text-gray-400">Admin Panel</p>
        </div>
      </a>
    </div>

    <nav class="flex-1 px-4 py-6 space-y-1">
      <a href="/admin" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium hover:bg-secondary transition text-foreground">
        📊 Dashboard
      </a>
      <a href="/admin/orders" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium hover:bg-secondary transition text-foreground">
        📦 Orders
      </a>
      <a href="/admin/products" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium hover:bg-secondary transition text-foreground">
        🍰 Products
      </a>
      <a href="/admin/calendar" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium hover:bg-secondary transition text-foreground">
        📅 Calendar
      </a>
      <a href="/admin/analytics" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium hover:bg-secondary transition text-foreground">
        📈 Analytics
      </a>
    </nav>

    <div class="px-4 py-4 border-t border-border">
      <a href="/" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium hover:bg-secondary transition text-gray-500 mb-1">
        🌐 View Website
      </a>
      <a href="/admin/logout" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium hover:bg-red-50 hover:text-red-600 transition text-gray-500">
        🚪 Logout
      </a>
    </div>
  </aside>

  <!-- Main content -->
  <main class="flex-1 ml-64 p-8">
    {% block content %}{% endblock %}
  </main>

</div>

</body>
</html>