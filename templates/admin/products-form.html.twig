{% extends 'layout.html.twig' %}

{% block content %}

<section class="py-16 px-4 bg-secondary min-h-screen">
  <div class="container mx-auto max-w-2xl">

    <h1 class="text-4xl font-bold mb-8">
      {{ product is defined and product.id ? 'Edit Product' : 'Add Product' }}
    </h1>

    <div class="bg-white rounded-xl shadow p-8">
      <form method="POST"
            action="{{ product is defined and product.id ? '/admin/products/' ~ product.id ~ '/edit' : '/admin/products/create' }}">

        <div class="mb-4">
          <label class="block text-sm font-medium mb-1">Product Name *</label>
          <input type="text" name="name" required
                 value="{{ product.name ?? '' }}"
                 class="w-full border border-border rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30">
        </div>

        <div class="mb-4">
          <label class="block text-sm font-medium mb-1">Description</label>
          <textarea name="description" rows="4"
                    class="w-full border border-border rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 resize-none">{{ product.description ?? '' }}</textarea>
        </div>

        <div class="mb-4">
          <label class="block text-sm font-medium mb-1">Category *</label>
          <select name="category_id" required
                  class="w-full border border-border rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30">
            <option value="">Select category...</option>
            {% for category in categories %}
              <option value="{{ category.id }}"
                {{ (product is defined and product.category_id == category.id) ? 'selected' : '' }}>
                {{ category.name }}
              </option>
            {% endfor %}
          </select>
        </div>

        <div class="mb-4">
          <label class="block text-sm font-medium mb-1">Base Price ($)</label>
          <input type="number" name="base_price" step="0.01" min="0"
                 value="{{ product.base_price ?? '0' }}"
                 placeholder="0 = price on request"
                 class="w-full border border-border rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30">
        </div>

        <div class="mb-4">
          <label class="block text-sm font-medium mb-1">Image URL</label>
          <input type="text" name="image_url"
                 value="{{ product.image_url ?? '' }}"
                 placeholder="https://..."
                 class="w-full border border-border rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30">
        </div>

        <div class="flex gap-6 mb-6">
          <label class="flex items-center gap-2 text-sm cursor-pointer">
            <input type="checkbox" name="is_available" value="1"
                   {{ (product is not defined or product.is_available) ? 'checked' : '' }}
                   class="rounded">
            Available
          </label>
          <label class="flex items-center gap-2 text-sm cursor-pointer">
            <input type="checkbox" name="is_presale" value="1"
                   {{ (product is defined and product.is_presale) ? 'checked' : '' }}
                   class="rounded">
            Presale Item
          </label>
        </div>

        <div class="flex gap-4">
          <button type="submit"
                  class="bg-primary text-white px-6 py-2 rounded-full font-medium hover:bg-primary/90 transition shadow-sm">
            {{ product is defined and product.id ? 'Save Changes' : 'Add Product' }}
          </button>
          <a href="/admin/products"
             class="bg-white border border-border px-6 py-2 rounded-full text-sm font-medium hover:bg-secondary transition">
            Cancel
          </a>
        </div>

      </form>
    </div>

  </div>
</section>

{% endblock %}