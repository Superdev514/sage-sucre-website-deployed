<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Contact | Sage Sucre – Get in Touch for Custom Cakes & Treats</title>
  <!-- Tailwind CSS + Google Fonts + Font Awesome for Icons (replacing lucide) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#e07a5f',
            secondary: '#fdf3e7',
            background: '#fffaf5',
            foreground: '#2c2b28',
            muted: {
              foreground: '#6b6a66',
              DEFAULT: '#f8f4ef',
            },
            border: '#e9e2d8',
            card: '#ffffff',
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'Segoe UI', 'Roboto', 'Helvetica Neue', 'sans-serif'],
          },
          borderRadius: {
            'xl': '1rem',
            '2xl': '1.5rem',
          },
          animation: {
            'fade-in': 'fadeIn 0.5s ease forwards',
          },
          keyframes: {
            fadeIn: { '0%': { opacity: '0', transform: 'translateY(10px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } },
          }
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { background: #fffaf5; }
    .contact-card {
      transition: all 0.25s ease;
    }
    .contact-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 25px -12px rgba(0, 0, 0, 0.1);
    }
    .quick-item {
      transition: all 0.2s;
    }
    .quick-item:hover {
      background-color: #fef6ef;
      border-color: #e07a5f30;
      transform: translateX(3px);
    }
    .icon-hover {
      transition: background 0.2s;
    }
    .group:hover .icon-hover {
      background-color: rgba(224, 122, 95, 0.2);
    }
  </style>
</head>
<body class="font-sans text-foreground antialiased">

  <div class="min-h-screen flex flex-col">
    <!-- Header Section -->
    <section class="py-16 px-4 text-center bg-secondary border-b border-border/40">
      <div class="container mx-auto max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">Get in Touch</h1>
        <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
          Have questions? Want to discuss a custom order? I'd love to hear from you!
        </p>
      </div>
    </section>

    <!-- Contact Methods (Instagram + Email) -->
    <section class="py-16 px-4">
      <div class="container mx-auto max-w-4xl">
        <div class="grid md:grid-cols-2 gap-8 mb-16">
          <!-- Instagram Card (Preferred) -->
          <a href="https://instagram.com/sagesucre" target="_blank" rel="noopener noreferrer" 
             class="bg-white border border-border rounded-2xl p-8 contact-card group cursor-pointer">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0 group-hover:bg-primary/20 transition-all icon-hover">
                <i class="fab fa-instagram text-primary text-2xl"></i>
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold mb-2">Instagram (Preferred)</h3>
                <p class="text-muted-foreground text-sm mb-3 leading-relaxed">
                  DM me on Instagram for the fastest response! You can also browse my latest 
                  creations and get inspiration for your order.
                </p>
                <p class="text-primary font-medium">@sagesucre</p>
              </div>
            </div>
          </a>

          <!-- Email Card -->
          <a href="mailto:hello@sagesucre.com" 
             class="bg-white border border-border rounded-2xl p-8 contact-card group cursor-pointer">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0 group-hover:bg-primary/20 transition-all icon-hover">
                <i class="fas fa-envelope text-primary text-2xl"></i>
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold mb-2">Email</h3>
                <p class="text-muted-foreground text-sm mb-3 leading-relaxed">
                  Prefer email? Send me a message and I'll get back to you within 24 hours.
                </p>
                <p class="text-primary font-medium">hello@sagesucre.com</p>
              </div>
            </div>
          </a>
        </div>

        <!-- Response Time Box -->
        <div class="bg-primary/5 border border-primary/20 rounded-2xl p-8 text-center mb-16">
          <i class="fas fa-clock text-primary text-3xl mb-4"></i>
          <h3 class="text-xl font-bold mb-3">Response Time</h3>
          <p class="text-muted-foreground max-w-2xl mx-auto">
            I typically respond within 24 hours (Monday-Friday). Weekend messages will be 
            answered on Monday. For urgent orders, please reach out on Instagram for faster communication.
          </p>
        </div>

        <!-- What to Include Section -->
        <div class="bg-white border border-border rounded-2xl p-8 shadow-sm">
          <h3 class="text-2xl font-bold mb-6 text-center">When Reaching Out, Please Include:</h3>
          <div class="grid md:grid-cols-2 gap-8">
            <div>
              <h4 class="mb-3 flex items-center gap-2 font-semibold text-lg">
                <i class="fas fa-comment-dots text-primary"></i>
                Basic Info
              </h4>
              <ul class="text-sm text-muted-foreground space-y-2.5">
                <li><i class="fas fa-check-circle text-primary text-xs mr-2"></i> Your name</li>
                <li><i class="fas fa-check-circle text-primary text-xs mr-2"></i> Type of product you want (cake, cupcakes, etc.)</li>
                <li><i class="fas fa-check-circle text-primary text-xs mr-2"></i> Number of servings or pieces</li>
                <li><i class="fas fa-check-circle text-primary text-xs mr-2"></i> Preferred pickup date</li>
              </ul>
            </div>
            <div>
              <h4 class="mb-3 flex items-center gap-2 font-semibold text-lg">
                <i class="fas fa-palette text-primary"></i>
                Design Details
              </h4>
              <ul class="text-sm text-muted-foreground space-y-2.5">
                <li><i class="fas fa-check-circle text-primary text-xs mr-2"></i> Flavor preferences</li>
                <li><i class="fas fa-check-circle text-primary text-xs mr-2"></i> Color scheme or theme</li>
                <li><i class="fas fa-check-circle text-primary text-xs mr-2"></i> Any special requests or dietary needs</li>
                <li><i class="fas fa-check-circle text-primary text-xs mr-2"></i> Inspiration photos (if you have them)</li>
              </ul>
            </div>
          </div>
          <div class="mt-8 text-center border-t border-border pt-6">
            <p class="text-sm text-muted-foreground mb-4">
              Or better yet, use the order form to submit all your details at once!
            </p>
            <a href="#" class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-full hover:bg-primary/90 transition-all shadow-sm text-base font-medium">
              <i class="fas fa-cake-candles"></i> Fill Out Order Form
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Answers (FAQ compact) -->
    <section class="py-16 px-4 bg-secondary">
      <div class="container mx-auto max-w-4xl">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center">Quick Answers</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-xl border border-border quick-item transition-all">
            <h3 class="font-bold mb-2 flex items-center gap-2"><i class="fas fa-calendar-alt text-primary text-sm"></i> How much advance notice do you need?</h3>
            <p class="text-sm text-muted-foreground">Minimum 48 hours for all orders. Custom cakes and large orders need 1-2 weeks notice.</p>
          </div>
          <div class="bg-white p-6 rounded-xl border border-border quick-item transition-all">
            <h3 class="font-bold mb-2 flex items-center gap-2"><i class="fas fa-truck text-primary text-sm"></i> Do you offer delivery?</h3>
            <p class="text-sm text-muted-foreground">Pickup is preferred, but delivery may be available for an additional fee depending on location.</p>
          </div>
          <div class="bg-white p-6 rounded-xl border border-border quick-item transition-all">
            <h3 class="font-bold mb-2 flex items-center gap-2"><i class="fas fa-paintbrush text-primary text-sm"></i> Can you do custom designs?</h3>
            <p class="text-sm text-muted-foreground">Absolutely! Send me your inspiration photos and ideas, and I'll create something special for you.</p>
          </div>
          <div class="bg-white p-6 rounded-xl border border-border quick-item transition-all">
            <h3 class="font-bold mb-2 flex items-center gap-2"><i class="fas fa-credit-card text-primary text-sm"></i> What payment methods do you accept?</h3>
            <p class="text-sm text-muted-foreground">E-transfer is preferred. 50% deposit required to confirm, remaining balance due at pickup.</p>
          </div>
        </div>
        <div class="text-center mt-8">
          <a href="#" class="text-primary hover:underline font-medium inline-flex items-center gap-1">See more FAQs on the About page <i class="fas fa-arrow-right text-xs"></i></a>
        </div>
      </div>
    </section>

    <!-- Social Proof / Instagram Showcase -->
    <section class="py-20 px-4">
      <div class="container mx-auto max-w-3xl text-center">
        <i class="fab fa-instagram text-primary text-4xl mb-5"></i>
        <h2 class="text-3xl md:text-4xl font-bold mb-5">See My Work on Instagram</h2>
        <p class="text-muted-foreground mb-8 text-lg max-w-xl mx-auto">
          Check out photos of my recent creations, customer reviews, and behind-the-scenes 
          baking content. It's the best way to get inspired for your own order!
        </p>
        <a href="https://instagram.com/sagesucre" target="_blank" rel="noopener noreferrer" 
           class="inline-flex items-center gap-2 bg-primary text-white px-8 py-3 rounded-full hover:bg-primary/90 transition-all shadow-md text-base font-medium">
          <i class="fab fa-instagram"></i> Visit @sagesucre on Instagram
        </a>
      </div>
    </section>

    <!-- Simple Footer -->
    <footer class="bg-white border-t border-border py-8 text-center text-sm text-muted-foreground">
      <div class="container mx-auto px-4">
        <p>🍰 Sage Sucre — handmade with love by Sabrina. Let's sweeten your celebration.</p>
        <div class="mt-2 flex justify-center gap-5">
          <a href="#" class="hover:text-primary transition">Home</a>
          <a href="#" class="hover:text-primary transition">Menu</a>
          <a href="#" class="hover:text-primary transition">Order</a>
          <a href="https://instagram.com/sagesucre" target="_blank" class="hover:text-primary transition">Instagram</a>
        </div>
      </div>
    </footer>
  </div>

  <!-- Smooth scroll for hash links -->
  <script>
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        const href = this.getAttribute('href');
        if (href === "#" || href === "#/") return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  </script>
</body>
</html>